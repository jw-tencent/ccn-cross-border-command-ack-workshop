# Node.js listener. Bind to loopback and put TLS/WSS at a reviewed reverse proxy.
HOST=127.0.0.1
PORT=8787

# Comma-separated exact browser Origins. Do not use wildcards.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Production example:
# ALLOWED_ORIGINS=https://demo.example.com

VERSION=0.1.0
MAX_PAYLOAD_BYTES=65536
DEDUPE_TTL_MS=60000
